                            $currentSession = AcademicSession::where('is_current', true)->first();
$sessionCode = str_replace('/', '-', $currentSession->name); 
// e.g. "2024/2025" → "24-25"

// Get last student for this session
$lastStudent = Student::where('roll_id', 'like', "AGM/$sessionCode/%")
                      ->orderBy('id', 'desc')
                      ->first();

if ($lastStudent) {
    $lastSeq = (int) substr($lastStudent->roll_id, strrpos($lastStudent->roll_id, '/') + 1);
    $nextSeq = $lastSeq + 1;
} else {
    $nextSeq = 1;
}

$roll_id = "AGM/$sessionCode/" . str_pad($nextSeq, 4, '0', STR_PAD_LEFT);



